/* CSS Document */


ul { margin: 1; padding: 0; }
li { list-style-position: outside; list-style: none;}
ul#dropmenu,ul#dropmenu ul{
margin: 0 auto;
text-align: left;
padding: 1;
list-style: none;
z-index: 99;
}
a {
	text-decoration: none;
}     /*Control the whole area links color   */
ul#dropmenu {
	width: auto;
	display: block;
	height: 16px;     /* determine the height of father menu bar */
	clear: both;
	border: 1px solid #ccc;
	text-align: center;    /* The color the the father menu bar background*/
	background-color: #666666;
}
ul#dropmenu li {

position: relative;
z-index: 999;
float: left;
}
ul#dropmenu ul li{

float: left;
display: block;
}
ul#dropmenu ul li{

width: 130px;
border: 0;
}
ul#dropmenu ul {
/*width: 122px;
w\idth: 120px;*/
width: 168px;    /*useless on the control of the width of the sub pop menu*/
w\idth: 168px;   /*control the sub menu pop width ! determine the sub pop menu width before padding implemented*/
height: auto;   /* control useless*/
position: absolute;
text-align: left;
left: 0px;
display: none;
border: solid 1px #ccc;

}
/*when mouse stop onto the sub menu and father menu,  this the style of father menu*/
ul#dropmenu li.over a,ul#dropmenu li:hover a{
	border-color: #ccc;  /*the color of the father menu item back ground. Pay attention, if adding "v" after colon, the  font color of menu item will still a original when mouse cursor move over*/
	color: #fff;
	background-color: #0000FF;
}
/*erase the style of child menu*/
ul#dropmenu li.over ul a,ul#dropmenu li:hover ul a{
	font-weight: normal;
	color: #333333;
	background: #fff;
	background: #f6f6f6;   /* the color of the child pop up menu back ground */
}
/*the hover style of child menu*/
ul#dropmenu li.over ul a:hover,ul#dropmenu li:hover ul a:hover{
	font-weight: normal;
	color: #FFFFFF;    /* the color of sub menu items*/
	font-weight: bold;  /* the background of sub menu items*/
	background-color: #0000FF;
}
/* Styles for Menu Items */
ul#dropmenu a {
	display: block;
	padding: 0 0 0 0px;
	width: 90px;
	w\idth: 88px;
	color: #FFFFFF;
	line-height: 16px;  /* have a influence on whole menu layout height*/
	font-size: 12px;
}
/* End */
ul#dropmenu ul a {
FILTER: progid:DXImageTransform.Microsoft.Alpha(opacity=70); /* make the menu become transparent, but merely take effect in IE*/
	padding: 1px 4px 1px 4px;  /* the first and thrid item control the pading between every lines under sub menu system; however, the second and the fourth items control the left and right pading!*/
	border: 1;
	width: 160px;  /*useless on the control of the width of the sub pop menu*/
	w\idth: 160px;/* Sub Menu Styles */  /*control the sub menu pop width! determine the sub pop menu width after padding implemented */
}
ul#dropmenu li:hover ul,ul#dropmenu li.over ul {
display: block; /* The magic */
}

-->
</style>



